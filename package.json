{
    "name": "rabbitdock",
    "productName": "RabbitDock",
    "desktopName": "io.github.rabbitdock.rabbitdock.desktop",
    "version": "0.1.0",
    "private": true,
    "description": "Modular desktop app for Windows and Linux",
    "license": "MIT",
    "author": "Eduardo Hillesheim",
    "main": "./out/main/index.js",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "install-electron && electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "preview": "install-electron && electron-vite preview",
        "typecheck": "tsc -b",
        "test:smoke": "install-electron && playwright test",
        "dist": "npm run build && electron-builder --publish never",
        "brand": "node scripts/build-brand.mts"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "electron": "^45.5.0",
        "electron-builder": "^26.18.0",
        "electron-vite": "^6.0.0",
        "opentype.js": "^2.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.8"
    }
}
