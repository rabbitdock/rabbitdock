{
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "strict": true,
        "target": "ES2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ES2025"],
        "types": ["node"],
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": [
        "electron.vite.config.ts",
        "playwright.config.ts",
        "src/main/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
        "scripts/**/*",
        "e2e/**/*"
    ],
    "exclude": ["e2e/fixtures/modules/*/src/**/*"]
}
