{
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo",
        "strict": true,
        "target": "ES2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ES2025", "DOM"],
        "types": ["vite/client"],
        "jsx": "react-jsx",
        "isolatedModules": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/renderer/src/*"]
        }
    },
    "include": ["src/renderer/src/**/*", "src/shared/**/*"]
}
