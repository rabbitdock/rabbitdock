{
    "compilerOptions": {
        "noEmit": true,
        "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo",
        "strict": true,
        "target": "ES2025",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ES2025", "DOM"],
        "jsx": "react-jsx",
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src/renderer/src/**/*"]
}
